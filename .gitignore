# This repository publishes only the website project.
/*
!/.gitignore
!/网站/

# System / editor files
.DS_Store
Thumbs.db
*.swp
*.swo

# Generated deployment output and Python cache
/网站/dist/
/网站/*.html
__pycache__/
*.py[cod]

# Local secrets and private learning-data exports
.env
.env.*
!/网站/.env.example
*.pem
*.key
/backups/
*backup*.json
*备份*.json
*.log
